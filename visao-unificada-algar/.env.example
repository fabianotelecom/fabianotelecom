# === Supabase ===
# Painel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Service role — USO EXCLUSIVO SERVER-SIDE (coletor). Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# === Criptografia dos Tokens de API dos Parceiros ===
# Chave AES-256-GCM (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=chave_base64_de_32_bytes

# === APIs Vonix ===
# Base da API por parceiro: https://{customer}.api.vonixcc.com.br
# O 'customer' e o token ficam no cadastro do parceiro (token criptografado).
# Autenticação: header Authorization: Bearer <token>.
VONIX_API_TIMEOUT_MS=8000
# Teto de filas cujo status é consultado por ciclo (proteção)
VONIX_MAX_QUEUE_STATUS=150
