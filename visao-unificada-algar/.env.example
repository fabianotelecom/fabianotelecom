# === Supabase ===
# Painel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Service role — USO EXCLUSIVO SERVER-SIDE (coletor). Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# === Criptografia dos Tokens de API dos Parceiros ===
# Chave AES-256-GCM (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=chave_base64_de_32_bytes

# === APIs Vonix ===
# Base usada como fallback/documentação. Cada parceiro tem sua própria url_vonix no cadastro.
VONIX_API_TIMEOUT_MS=8000
